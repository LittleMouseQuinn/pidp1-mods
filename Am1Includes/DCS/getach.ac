#ifndef GETACH_AH
#define GETACH_AH

// Wait for an ascii character on the current DCS channel.
// The IO register is cleared and the character is
// returned in the IO register.
// The AC register is preserved.
// Call via jda getach.

#include <DCS/dcs2defs.ah>

getach,  0
local
     dap %gachrt

#ifdef SIMH_COMPAT
// Stock SIMH's Type 630 DCS exposes scanner readiness through the DCS bit
// in CKS.  Every SIMH_COMPAT TCB consumes its transmit-completion scanner
// flag before returning, so scanner-ready here represents received input in
// the normal interactive request/response path.
%gachlp,
     cli
     cks
     lai
     and [SIMH_DCS_READY]
     sza i
     jmp %gachlp
     cli
     rch rchclr
     rsc
     jmp %gacdn
#else
// DCS2 path: poll the current channel status until data is ready or an
// error/close is reported.
%gachlp,
     cli
     rcs
     lai
     and [dsfser dsfcls
     sza
     jmp %gacher
     lai
     and [dsfrdy
     sza i
     jmp %gachlp
     rch rchclr
     spi
     jmp %gacher
     jmp %gacdn
%gacher,
     lai
     ior [400000
     lia
#endif

%gacdn,
     lac getach
%gachrt,  jmp .
endloc

#endif
