#ifndef GETACH_AH
#define GETACH_AH

// Wait for an ascii character on the current DCS channel.
// The IO register is cleared and the character is returned in the IO register.
// If an error occurs, the IO register will be the rcs status with bit 0 set to 1.
// The AC register is preserved.
// Call via jda getach.
// Can be called safely cross-bank.

#include <DCS/dcs2defs.ah>

getach,  0
local rtn, loop, done, err
     dac rtn
     // Check to see if eem is on.
     // If not, the return address needs to be masked to 12 bits.
     and [0200000
     sza
     jmp loop       // it's on, ok to proceed
     lac rtn
     and [07777
     dac rtn

loop,
#ifdef SIMH_COMPAT
     // Stock SIMH's Type 630 DCS exposes scanner readiness through the DCS
     // bit in CKS. SIMH_COMPAT TCB consumes each transmit-completion scanner
     // flag before returning, so scanner-ready here represents received input
     // in Adventure's normal interactive request/response path.
     cli
     cks
     lai
     and [SIMH_DCS_READY
     sza i
     jmp loop
     cli
     rch rchclr
     rsc
     jmp done
#else
     // DCS2 path: poll the current channel status until data is ready or an
     // error/close is reported.
     cli
     rcs
     lai
     and [dsfser dsfcls
     sza
     jmp err
     lai
     and [dsfrdy
     sza i
     jmp loop
     rch rchclr
     spi
     jmp err
     jmp done
err,
     lai
     ior [400000
     lia
#endif

done,
     lac getach
     jmp i rtn
rtn, 0
endloc

#endif
