diff --git a/FunStuff/Shrdlu/Shrdlu/simh-dcs.ah b/FunStuff/Shrdlu/Shrdlu/simh-dcs.ah
new file mode 100644
index 0000000..01af65d
--- /dev/null
+++ b/FunStuff/Shrdlu/Shrdlu/simh-dcs.ah
@@ -0,0 +1,26 @@
+// Experimental PDP-1 stock-SIMH Type 630 compatibility for SHRDLU.
+// Keep DCS2's symbols, override only the operations and status bits used here.
+// Stock Type 630 echoes received bytes itself and has no TCP-connect status.
+// The first incoming byte starts a session and is consumed by ROC.
+#ifndef SHRDLU_SIMH_DCS_AH
+#define SHRDLU_SIMH_DCS_AH
+#define SIMH_DCS_READY 000002
+#undef rch
+#define rch iot 1022     // RCC reads and unlocks SIMH's scanner in one word
+#undef rcs
+#define rcs cks
+#undef roc
+#define roc rchr        // consume the first receive/status event
+#undef tcb
+#define tcb jsp i [simhtcb:0]
+#undef scb
+#define scb nop
+#undef dsfcon
+#define dsfcon SIMH_DCS_READY
+#undef dsfrdy
+#define dsfrdy SIMH_DCS_READY
+#undef dsfcls
+#define dsfcls 000000
+#undef dseflf
+#define dseflf 000000
+#endif
diff --git a/FunStuff/Shrdlu/Shrdlu/simhshrdlu.ac b/FunStuff/Shrdlu/Shrdlu/simhshrdlu.ac
new file mode 100644
index 0000000..ec6a4b2
--- /dev/null
+++ b/FunStuff/Shrdlu/Shrdlu/simhshrdlu.ac
@@ -0,0 +1,22 @@
+// Experimental stock-SIMH Type 630 serialized transmit helper.
+// Called with JSP from any bank; IO holds the byte to send.
+// All current SHRDLU TCB call sites discard AC after transmitting.
+simhtcb,
+    local ret, wait
+    dac ret
+    // Type 630 TCC sends on the selected scanner line AND releases its
+    // scanner lock. TCB alone can leave an older IOS_DCS ready bit latched
+    // across a long hand animation; the next TCB then overwrites the
+    // still-pending first character. This single-line shim uses scan=send.
+    tcc
+wait, cli
+    cks
+    lai
+    and [SIMH_DCS_READY]
+    sza i
+    jmp wait
+    cli
+    rchr
+    jmp i ret
+ret, 0
+    endloc
diff --git a/tests/diag_shrdlu_motion.py b/tests/diag_shrdlu_motion.py
new file mode 100755
index 0000000..47255a1
--- /dev/null
+++ b/tests/diag_shrdlu_motion.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Bounded guest-state probe of PDP-1 SHRDLU motion; experimental SIMH only.
+
+The addresses match the Nov4 b4f6f40 source: regenerate symbol addresses if
+using a different guest build. The probe is not a passing gameplay test.
+"""
+import argparse
+import os
+from pathlib import Path
+import select
+import signal
+import socket
+import subprocess
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+PROGRAM = ROOT / 'FunStuff' / 'Shrdlu' / 'Shrdlu'
+DUMP = {'hpPend': '005270', 'hpDue': '005274', 'hpPaced': '005273',
+        'dpGrp': '005256', 'dpFrames': '005257', 'dpEdges': '005262',
+        'dpSwap': '005255', 'dpFront': '005254', 'clT': '005260'}
+
+def recv_until(sock, marker, limit):
+    b=bytearray(); end=time.monotonic()+limit
+    while time.monotonic()<end:
+        ready, _, _=select.select([sock],[],[],min(.25,max(0,end-time.monotonic())))
+        if ready:
+            piece=sock.recv(65536)
+            if not piece: break
+            b.extend(piece)
+            if marker in b: break
+    return bytes(b)
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--simh',type=Path,required=True)
+    ap.add_argument('--program',type=Path,default=PROGRAM, help='SHRDLU build directory')
+    ap.add_argument('--input-timeout',type=float,default=45)
+    ap.add_argument('--post-words',type=float,default=30)
+    a=ap.parse_args()
+    program=a.program.resolve()
+    assert (program / 'shrdlu-simh.rim').is_file()
+    assert (program / 'shrdlu-simh-drum.img').is_file()
+    with socket.socket() as s:
+        s.bind(('127.0.0.1',0));port=s.getsockname()[1]
+    commands='\n'.join('examine '+addr for addr in DUMP.values())
+    cfg=f'''set cpu pdp1d48
+set cpu 64k
+set cpu nosbs
+set t340 enabled
+set clk enabled
+set drp enabled
+attach drp {program / 'shrdlu-simh-drum.img'}
+set dcs enabled
+set dcs lines=1
+set dcsl0 8b
+attach dcs {port}
+attach ptr {program / 'shrdlu-simh.rim'}
+boot ptr
+{commands}
+show clk
+show t340
+exit
+'''
+    with tempfile.TemporaryDirectory() as tmp:
+        ini=Path(tmp)/'run.ini';ini.write_text(cfg)
+        log=Path(tmp)/'console.log'
+        with open(log,'w+b') as out:
+            proc=subprocess.Popen([str(a.simh.resolve()),str(ini)],cwd=program,
+                                  stdin=subprocess.DEVNULL,stdout=out,stderr=subprocess.STDOUT,
+                                  start_new_session=True)
+            s=None
+            try:
+                for _ in range(120):
+                    if proc.poll() is not None:raise RuntimeError('SIMH died early')
+                    try:s=socket.create_connection(('127.0.0.1',port),timeout=.3);break
+                    except OSError:time.sleep(.1)
+                if s is None:raise RuntimeError('DCS did not listen')
+                s.sendall(b'\r')
+                banner=recv_until(s,b'\n*\n',12)
+                print('BANNER:',banner[-140:].decode('latin1','replace').strip())
+                s.sendall(b'PICK UP A BIG RED BLOCK.\r\n')
+                reply=recv_until(s,b'WORDS: PICK UP A BIG RED BLOCK .',a.input_timeout)
+                parsed=b'WORDS: PICK UP A BIG RED BLOCK .' in reply
+                print('PARSED:',parsed,'TAIL:',reply[-420:].decode('latin1','replace').strip())
+                if parsed:
+                    tail=recv_until(s,b'\n*\n',a.post_words)
+                    print('MOTION FINISHED:',b'\n*\n' in tail,'TAIL:',tail[-520:].decode('latin1','replace').strip())
+            finally:
+                if s:s.close()
+                if proc.poll() is None:
+                    os.killpg(proc.pid,signal.SIGINT)
+                    try:proc.wait(timeout=4)
+                    except subprocess.TimeoutExpired:
+                        os.killpg(proc.pid,signal.SIGTERM)
+                        try:proc.wait(timeout=3)
+                        except subprocess.TimeoutExpired:
+                            os.killpg(proc.pid,signal.SIGKILL);proc.wait()
+            out.seek(0)
+            print('SIMH STATE:\n'+out.read()[-4500:].decode('latin1','replace'))
+
+if __name__=='__main__':main()
diff --git a/tests/run_shrdlu_simh_smoke.py b/tests/run_shrdlu_simh_smoke.py
new file mode 100755
index 0000000..fa0521c
--- /dev/null
+++ b/tests/run_shrdlu_simh_smoke.py
@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""End-to-end PDP-1 SHRDLU stock-SIMH text/overlay regression. Python stdlib only."""
+import argparse
+from pathlib import Path
+import os
+import select
+import signal
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+
+PROGRAM = Path(__file__).resolve().parents[1] / "FunStuff" / "Shrdlu" / "Shrdlu"
+
+
+def read_until_mark(sock, seconds):
+    data = bytearray()
+    end = time.monotonic() + seconds
+    while time.monotonic() < end and len(data) < 65536:
+        rd, _, _ = select.select([sock], [], [], min(0.2, max(0.0, end - time.monotonic())))
+        if not rd:
+            continue
+        try:
+            chunk = sock.recv(8192)
+        except BlockingIOError:
+            continue
+        if not chunk:
+            break
+        data.extend(chunk)
+        if b"\n*\n" in data:
+            return bytes(data)
+    raise AssertionError("SHRDLU did not finish its reply; tail=" + repr(bytes(data[-500:])))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--simh", required=True, type=Path, help="PDP-1 SIMH binary with experimental Type 340 and CCT")
+    parser.add_argument("--timeout", type=float, default=18.0)
+    parser.add_argument("--prefix", choices=("shrdlu-simh", "shrdlu-simh-fast", "shrdlu-simh-paced"), default="shrdlu-simh",
+                        help="Which built guest tape/drum pair to boot")
+    parser.add_argument("--motion", action="store_true", help="Also exercise the hand-motion command")
+    args = parser.parse_args()
+    simh = args.simh.resolve()
+    if not simh.is_file():
+        parser.error("SIMH executable not found: " + str(simh))
+    for name in (args.prefix + ".rim", args.prefix + "-drum.img"):
+        if not (PROGRAM / name).is_file():
+            parser.error("Build the requested SHRDLU variant first; missing " + name)
+
+    # Reserve an otherwise free port; the simulator opens it immediately after release.
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        port = probe.getsockname()[1]
+
+    cfg = f"""set cpu pdp1d48
+set cpu 64k
+set cpu nosbs
+set t340 enabled
+set clk enabled
+set drp enabled
+attach drp {PROGRAM / (args.prefix + '-drum.img')}
+set dcs enabled
+set dcs lines=1
+set dcsl0 8b
+attach dcs {port}
+attach ptr {PROGRAM / (args.prefix + '.rim')}
+boot ptr
+"""
+    with tempfile.TemporaryDirectory() as temp:
+        cfg_file = Path(temp) / "shrdlu-test.ini"
+        cfg_file.write_text(cfg)
+        with open(Path(temp) / "simh.log", "w+b") as log:
+            process = subprocess.Popen(
+                [str(simh), str(cfg_file)],
+                cwd=PROGRAM,
+                stdin=subprocess.DEVNULL,
+                stdout=log,
+                stderr=subprocess.STDOUT,
+                start_new_session=True,
+            )
+            sock = None
+            result = 1
+            try:
+                started = time.monotonic()
+                while time.monotonic() - started < args.timeout:
+                    if process.poll() is not None:
+                        raise AssertionError("SIMH exited before accepting a DCS connection")
+                    try:
+                        sock = socket.create_connection(("127.0.0.1", port), timeout=0.3)
+                        break
+                    except OSError:
+                        time.sleep(0.1)
+                if sock is None:
+                    raise AssertionError("SIMH did not listen on the DCS port")
+                sock.setblocking(False)
+                cases = [
+                    ("banner", b"\r", [b"SHRDLU: TYPE A SENTENCE", b"/STATUS, /RESET"]),
+                    ("dictionary", b"/WORD BLOCK\r\n", [b"BLOCK: NOUN NS"]),
+                    ("overlay command", b"/ROOM\r\n", [b"HEAP ", b"DATABASE ", b"DROPS "]),
+                    ("natural-language query", b"ARE THERE ANY BLOCKS?\r\n",
+                     [b"WORDS: ARE THERE ANY BLOCKS ?", b"YES, FIVE OF THEM:", b"THE BLUE ONE."]),
+                ]
+                if args.motion:
+                    cases.append(("hand movement", b"PICK UP A BIG RED BLOCK.\r\n",
+                                  [b"WORDS: PICK UP A BIG RED BLOCK .", b"OK.\n*\n"]))
+                for title, query, expected in cases:
+                    sock.sendall(query)
+                    response = read_until_mark(sock, args.timeout)
+                    missing = [s for s in expected if s not in response]
+                    if missing:
+                        raise AssertionError(f"{title} missing {missing!r}: {response[-750:]!r}")
+                    if title == "dictionary" and response.count(b"/WORD BLOCK") != 1:
+                        raise AssertionError("Type 630 and guest are both echoing input")
+                    print("PASS:", title)
+                result = 0
+            except Exception as exc:
+                print("FAIL:", exc, file=sys.stderr)
+            finally:
+                if sock is not None:
+                    sock.close()
+                try:
+                    os.killpg(process.pid, signal.SIGTERM)
+                except ProcessLookupError:
+                    pass
+                try:
+                    process.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    os.killpg(process.pid, signal.SIGKILL)
+                    process.wait()
+                if result:
+                    log.seek(0)
+                    print("SIMH console tail:", repr(log.read()[-800:]), file=sys.stderr)
+            return result
+
+
+if __name__ == "__main__":
+    sys.exit(main())
